  {
   "id": 2,
   "type": "stat",
   "title": "Disponibilidad (30 d)",
   "description": "SLO: 99,5 % de peticiones sin 5xx",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - sum(increase(xiro_http_request_duration_seconds_count{job=\"xiro-backend\",route!~\"/live|/ready\",status_code=~\"5..\"}[30d])) / sum(increase(xiro_http_request_duration_seconds_count{job=\"xiro-backend\",route!~\"/live|/ready\"}[30d]))",
     "legendFormat": "",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.995
       }
      ]
     }
    },
    "overrides": []
   }
  },
