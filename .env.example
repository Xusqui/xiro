# Configuración de PostgreSQL
DB_USER=postgres
DB_PASSWORD=xxasñdlfknaspoditjqñwsdlgknasñdlgknPSFODIKñkjòkmòinmÖIMíonÑoin
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=xiro_db

# Rutas NAS y puertos
XIRO_ROOT=/volume2/docker/xiro
APP_PORT=3000

# Pool de conexiones
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Límites del juego
MAX_PLAYERS_PER_GAME=100
QUESTION_TIME_LIMIT=30
GAME_CLEANUP_INTERVAL=3600000

# Seguridad
JWT_SECRET=tu_secreto_jwt_super_seguro_cambialo
# Contraseña Redis (mínimo 32 chars aleatorios: openssl rand -base64 32)
REDIS_PASSWORD=cambia_esto_por_una_clave_redis_segura

# Entorno
NODE_ENV=production
CORS_ORIGIN=https://xiro.pro,https://www.xiro.pro,http://localhost:3000,http://localhost
ALLOWED_ORIGINS=https://xiro.pro,https://www.xiro.pro,http://localhost:3000,http://localhost
SERVER_HOST=xiro.pro

# === CLEANUP AUTOMÁTICO ===
CLEANUP_THRESHOLD=14400000  # 4 horas (en ms)
CLEANUP_INTERVAL=3600000    # 1 hora (en ms)

# === LOGGING ===
LOG_LEVEL=info            # debug | info | warn | error
LOG_MAX_SIZE=20m          # Tamaño máximo por archivo de log
LOG_MAX_FILES=14d         # Retención de logs (14 días)

# === BACKUP AUTOMÁTICO ===
# Programación cron del backup (o "disabled" para desactivar)
# Opciones: "0 2 * * *" (diario 2am) | "0 2 * * 0" (semanal dom.) | "0 2 1 * *" (mensual)
BACKUP_SCHEDULE=0 2 * * *
# Días que se conservan los backups antes de eliminarse automáticamente
BACKUP_RETENTION_DAYS=7
# Ruta al fichero de secreto para backups (montado como /run/secrets/db_password)
# Si el contenido es __USE_ENV_DB_PASSWORD__ se usa DB_PASSWORD como fallback.
DB_PASSWORD_SECRET_FILE=./secrets/db_password.txt.template

# === SHUTDOWN ===
# Tiempo máximo de apagado (ms) antes de forzar salida
SHUTDOWN_TIMEOUT_MS=6000
# Espera tras notificar clientes (ms)
SHUTDOWN_NOTIFY_WAIT_MS=200
# Timeout de cierre para Socket.IO/HTTP (ms)
SHUTDOWN_CLOSE_TIMEOUT_MS=600

# === PUNTUACIÓN DE EQUIPOS ===
# Lambda (λ) para suavizado de puntuación por equipos
# Fórmula: Score_equipo = (Σ puntos_jugadores + λ × media_global) / (n_jugadores + λ)
# 
# - λ = 0: Media simple (puntos_equipo / n_jugadores)
# - λ > 0: Suaviza la varianza en equipos pequeños hacia la media global
# 
# Con λ = 0.5, un equipo de 4 jugadores tiene un pequeño amortiguador que reduce
# la volatilidad causada por outliers sin favorecer injustamente a equipos grandes.
# 
# Valores recomendados:
#   - λ = 0   → Sin suavizado (media simple)
#   - λ = 0.5 → Suavizado ligero (recomendado para equipos de 4-5 jugadores)
#   - λ = 1-2 → Suavizado moderado (para equipos más heterogéneos)
TEAM_SCORE_LAMBDA=0.5