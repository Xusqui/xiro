# =====================================================================
# Xiro! — plantilla de configuración
# Copia este fichero como .env junto al docker-compose.yml y cambia
# como mínimo los valores marcados con  <-- CAMBIAR
#
# Sirve para todas las formas de instalar (ver README):
#   A) Imágenes publicadas + Caddy, servidor público (docker-compose.deploy.yml)
#   B) Imágenes publicadas + tu proxy inverso, p. ej. un NAS (docker-compose.deploy.nas.yml)
#   C) Desde el código fuente (docker-compose.yml del repositorio)
# =====================================================================

# === RUTAS Y PUERTOS ===
# Ruta absoluta de este repositorio en el host, solo instalación C  <-- CAMBIAR (p. ej. /opt/xiro)
XIRO_ROOT=/volume2/docker/xiro
# Puerto del host donde se publica la app (instalaciones B y C); pon delante un proxy HTTPS
APP_PORT=3000
# Solo B: dirección donde escucha ese puerto. Por defecto 127.0.0.1 (proxy en el mismo host,
# como el de Synology DSM o QNAP QTS). Pon 0.0.0.0 o la IP de la LAN si el proxy está en otra
# máquina o en un contenedor sin acceso al host. No abras ese puerto en el router.
# APP_BIND=127.0.0.1

# === POSTGRESQL ===
DB_USER=postgres
# <-- CAMBIAR (sin espacios)
DB_PASSWORD=CAMBIA_LA_CONTRASENA_DE_POSTGRES
DB_HOST=db
# Puerto de Postgres dentro de la red Docker:
#   A, B) imágenes publicadas (docker-compose.deploy*.yml) → 5432
#   C)    desde el código fuente (docker-compose.yml)       → 5439
DB_PORT=5432
DB_NAME=xiro_db

# === SERVICIOS INTERNOS ===
# Nombres de los contenedores dentro de la red Docker; no cambiar.
# (En la instalación C, docker-compose.yml ya los fija y estos se ignoran.)
REDIS_URL=redis://redis:6379
CHROME_WS_ENDPOINT=ws://chrome:3000

# Pool de conexiones
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
# Opcionales (valores por defecto entre paréntesis):
# DB_CONNECTION_BUDGET  conexiones totales entre todos los workers PM2; DB_POOL_MAX se recorta a budget / workers (80, max_connections=100)
# DB_STATEMENT_TIMEOUT  ms que puede durar una sentencia en el servidor; 0 = sin límite (30000)
# DB_IDLE_IN_TX_TIMEOUT ms que una transacción abierta puede quedar inactiva antes de que Postgres la cierre (60000)
# DB_MAX_LIFETIME       segundos de vida de cada conexión antes de reciclarla (1800)

# === SEGURIDAD ===
# Genera valores aleatorios con: openssl rand -hex 32
# JWT_SECRET debe tener al menos 32 caracteres  <-- CAMBIAR
JWT_SECRET=CAMBIA_JWT_SECRET_POR_UNA_CADENA_ALEATORIA_LARGA
# <-- CAMBIAR
REDIS_PASSWORD=CAMBIA_REDIS_PASSWORD_POR_OTRA_CADENA_ALEATORIA

# Clave compartida entre el backend y el contenedor «updater» (botón «Actualizar» del panel,
# Configuración → Actualizaciones). Mínimo 32 caracteres; sin ella, el panel solo avisa de la
# versión nueva y muestra los comandos para actualizar a mano.  <-- CAMBIAR
UPDATER_TOKEN=CAMBIA_UPDATER_TOKEN_POR_OTRA_CADENA_ALEATORIA_LARGA

# === DOMINIO ===
# Dominio(s) públicos por los que se accede a Xiro!. Es obligatorio entrar por https://
# Separa varios con comas.  <-- CAMBIAR
CORS_ORIGIN=https://quiz.example.com
ALLOWED_ORIGINS=https://quiz.example.com
# Solo el nombre de host, sin https://  <-- CAMBIAR
SERVER_HOST=quiz.example.com

NODE_ENV=production

# === LÍMITES DEL JUEGO ===
MAX_PLAYERS_PER_GAME=2000
MAX_LOBBIES=5
QUESTION_TIME_LIMIT=30
GAME_CLEANUP_INTERVAL=3600000

# === LIMPIEZA AUTOMÁTICA ===
# Partidas inactivas durante más de 4 horas (ms) se eliminan
CLEANUP_THRESHOLD=14400000
# Frecuencia de la limpieza: 1 hora (ms)
CLEANUP_INTERVAL=3600000

# === LOGGING ===
# debug | info | warn | error
LOG_LEVEL=info
# Tamaño máximo por archivo de log
LOG_MAX_SIZE=20m
# Retención de logs
LOG_MAX_FILES=14d
# json = la consola (docker logs) en JSON de una línea, para Loki u otro agregador.
# Vacío = formato legible. Los ficheros de logs/ son siempre JSON.
# LOG_FORMAT=json

# === MONITORIZACIÓN (opcional, ver monitoring/README.md) ===
# true = manage.sh arranca también Prometheus, Alertmanager, Grafana y los exporters
XIRO_MONITORING=false
# Contraseña del usuario «admin» de Grafana (obligatoria con XIRO_MONITORING=true)  <-- CAMBIAR
GRAFANA_ADMIN_PASSWORD=
# Grafana solo escucha en 127.0.0.1:3001; 0.0.0.0 lo abre a la LAN
# GRAFANA_BIND=127.0.0.1
# GRAFANA_PORT=3001
# Opcional: exige este token en /metrics (red interna). Si lo pones, cópialo
# también en monitoring/secrets/metrics_token y actívalo en prometheus.yml.
# METRICS_TOKEN=
# Synology: carpeta de datos de Docker para cAdvisor (en otro Linux, /var/lib/docker)
# DOCKER_DATA_ROOT=/volume1/@docker

# === APAGADO ===
# Tiempo máximo de apagado (ms) antes de forzar la salida
SHUTDOWN_TIMEOUT_MS=6000
# Espera tras notificar a los clientes (ms)
SHUTDOWN_NOTIFY_WAIT_MS=200
# Timeout de cierre para Socket.IO/HTTP (ms)
SHUTDOWN_CLOSE_TIMEOUT_MS=600

# === CONEXIONES SOCKET.IO ===
# Máximo de conexiones nuevas por IP cada 60 segundos. Muchos jugadores
# detrás de la misma red (colegio, empresa) comparten IP: no lo bajes mucho.
SOCKETIO_IP_CONN_LIMIT=500

# === PUNTUACIÓN DE EQUIPOS ===
# Lambda (λ) para suavizar la puntuación por equipos:
#   Score_equipo = (Σ puntos_jugadores + λ × media_global) / (n_jugadores + λ)
#   λ = 0   → media simple, sin suavizado
#   λ = 0.5 → suavizado ligero (recomendado para equipos de 4-5 jugadores)
#   λ = 1-2 → suavizado moderado (equipos más heterogéneos)
TEAM_SCORE_LAMBDA=0.5

# === TELEMETRÍA ===
# Ping anónimo único de instalación a ntfy.sh (solo "Xiro! instalado" + versión).
# Sin datos personales. Pon false para desactivarlo. Ver README.
XIRO_TELEMETRY=true
