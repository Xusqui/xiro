{
  "name": "xiro",
  "version": "1.0.0",
  "description": "Servidor para juego tipo Kahoot",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "clean:appledouble": "find . -type f -name '._*' -delete",
    "test": "jest && npm run lint",
    "test:clean": "npm run clean:appledouble && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:clean": "npm run clean:appledouble && jest --coverage",
    "test:answer-lock:load-soak": "jest --runInBand application/commands/submit-answer/__tests__/distributedLock.concurrency.test.js",
    "test:trivial:spoof": "jest --runInBand sockets/handlers/__tests__/TrivialSocketHandler.security.test.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:report": "eslint . --ext .js --format json --output-file eslint-report.json",
    "migrate": "node migrations/migrate.js up",
    "migrate:status": "node migrations/migrate.js status",
    "migrate:create": "node migrations/migrate.js create",
    "update-assets": "node scripts/update-assets-version.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "services/**/*.js",
      "routes/**/*.js",
      "middlewares/**/*.js",
      "config/**/*.js",
      "application/**/*.js",
      "domain/**/*.js",
      "sockets/**/*.js",
      "infrastructure/**/*.js",
      "!**/node_modules/**",
      "!**/*.test.js",
      "!**/*.spec.js",
      "!**/__mocks__/**",
      "!**/__tests__/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js",
      "**/*.spec.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\._",
      "/__tests__/helpers/"
    ],
    "openHandlesTimeout": 0,
    "coverageThreshold": {
      "global": {
        "branches": 72,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "moduleNameMapper": {
      "^engine\\.io-client$": "<rootDir>/node_modules/engine.io-client/build/cjs/index.js",
      "^engine\\.io-parser$": "<rootDir>/node_modules/engine.io-parser/build/cjs/index.js",
      "^xmlhttprequest-ssl$": "<rootDir>/node_modules/xmlhttprequest-ssl/lib/XMLHttpRequest.js"
    }
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "puppeteer-core": "^24.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.1.0",
    "redis": "^4.7.0",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xstate": "^5.26.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "picomatch": "^4.0.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.3"
  }
}
