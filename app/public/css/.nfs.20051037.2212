        @keyframes xiroLoginGradient {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @keyframes loginOrb1 {

            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(30px, -40px) scale(1.1);
            }
        }

        @keyframes loginOrb2 {

            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }

            50% {
                transform: translate(-25px, 30px) scale(0.9);
            }
        }

        @keyframes mascoFloat {

            0%,
            100% {
                transform: scaleX(-1) translateY(0px);
            }

            50% {
                transform: scaleX(-1) translateY(-8px);
            }
        }

        @keyframes btnShimmer {
            0% {
                left: -100%;
            }

            100% {
                left: 150%;
            }
        }

        @keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(18px) scale(0.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        #login-overlay {
            background: linear-gradient(135deg, var(--console-ink, #0f172a) 0%, var(--admin-coral-darker, #7f1d1d) 45%, var(--admin-coral, #e65453) 100%) !important;
            background-size: 200% 200% !important;
            animation: xiroLoginGradient 30s ease-in-out infinite;
            overflow: hidden;
        }

        /* Ambient orbs */
        #login-overlay::before {
            content: '';
            position: absolute;
            width: 560px;
            height: 560px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, transparent 70%);
            top: -180px;
            left: -160px;
            border-radius: 50%;
            animation: loginOrb1 10s ease-in-out infinite;
            pointer-events: none;
        }

        #login-overlay::after {
            content: '';
            position: absolute;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(0, 0, 0, 0.12) 0%, transparent 70%);
            bottom: -120px;
            right: -120px;
            border-radius: 50%;
            animation: loginOrb2 13s ease-in-out infinite;
            pointer-events: none;
        }

        /* Card */
        .xiro-login-card {
            background: rgba(8, 12, 22, 0.82);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            box-shadow:
                0 32px 64px rgba(0, 0, 0, 0.45),
                0 0 0 1px rgba(var(--admin-coral-rgb, 230, 84, 83), 0.08),
                inset 0 1px 0 rgba(255, 255, 255, 0.06);
            animation: cardIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
            overflow: hidden;
        }

        .xiro-login-accent-bar {
            height: 3px;
            background: linear-gradient(90deg, var(--console-ink, #0f172a) 0%, var(--admin-coral-darker, #7f1d1d) 50%, var(--admin-coral, #e65453) 100%);
        }

        .xiro-login-inner {
            padding: 2.5rem 2.25rem 2rem;
        }

        .xiro-login-eyebrow {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(var(--admin-coral-rgb, 230, 84, 83), 0.7);
            text-align: center;
            margin-bottom: 0.25rem;
        }

        .xiro-login-title {
            font-family: 'Bebas Neue', cursive;
            font-size: 2.1rem;
            letter-spacing: 0.06em;
            text-align: center;
            line-height: 1;
            color: var(--surface-white, #ffffff);
            margin-bottom: 1.75rem;
        }

        .xiro-input-wrap {
            position: relative;
        }

        .xiro-input-wrap i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(148, 163, 184, 0.35);
            font-size: 0.85rem;
            pointer-events: none;
            transition: color 0.2s;
        }

        .xiro-login-input {
            font-family: 'DM Sans', sans-serif;
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1.5px solid rgba(255, 255, 255, 0.10);
            color: #f1f5f9;
            border-radius: 14px;
            padding: 13px 42px 13px 16px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        .xiro-login-input::placeholder {
            color: rgba(148, 163, 184, 0.35);
        }

        .xiro-login-input:focus {
            border-color: var(--admin-coral, #e65453) !important;
            box-shadow: 0 0 0 3px rgba(var(--admin-coral-rgb, 230, 84, 83), 0.18), inset 0 1px 4px rgba(0, 0, 0, 0.25);
            background: rgba(255, 255, 255, 0.07);
        }

        .xiro-input-wrap:focus-within i {
            color: rgba(var(--admin-coral-rgb, 230, 84, 83), 0.6);
        }

        /* Iris camaleónica: alterna visibilidad de contraseña. Anillo + pupila
           en ranura que se dilata y muda a coral al revelar, en vez del clásico
           icono de ojo tachado. */
        .xiro-input-wrap:has(.xiro-reveal-toggle) .xiro-login-input {
            padding-right: 46px;
        }

        .xiro-reveal-toggle {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: none;
            border-radius: 14px;
            padding: 0;
            cursor: pointer;
            color: rgba(148, 163, 184, 0.45);
            transition: background-color 0.2s ease, color 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .xiro-reveal-toggle:hover {
            background: rgba(255, 255, 255, 0.06);
            color: rgba(148, 163, 184, 0.75);
        }

        .xiro-reveal-toggle:focus-visible {
            outline: 2px solid var(--admin-coral, #e65453);
            outline-offset: 2px;
            background: rgba(255, 255, 255, 0.06);
        }

        .xiro-reveal-icon {
            display: block;
            overflow: visible;
        }

        .xiro-reveal-pupil {
            transform-origin: 12px 12px;
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .xiro-reveal-toggle.is-revealed {
            color: var(--admin-coral, #e65453);
        }

        .xiro-reveal-toggle.is-revealed .xiro-reveal-pupil {
            transform: scaleX(2.15);
        }

        .xiro-reveal-toggle:not(.is-revealed) .xiro-reveal-pupil {
            transition-duration: 0.22s;
            transition-timing-function: ease-in;
        }

        @keyframes xiroRevealPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(var(--admin-coral-rgb, 230, 84, 83), 0.45);
            }

            100% {
                box-shadow: 0 0 0 14px rgba(var(--admin-coral-rgb, 230, 84, 83), 0);
            }
        }

        .xiro-input-wrap.xiro-reveal-pulse .xiro-login-input {
            animation: xiroRevealPulse 0.55s ease-out;
        }

        @media (prefers-reduced-motion: reduce) {

            .xiro-reveal-toggle,
            .xiro-reveal-pupil {
                transition-duration: 0.01ms !important;
            }

            .xiro-input-wrap.xiro-reveal-pulse .xiro-login-input {
                animation: none !important;
            }
        }

        .xiro-login-btn {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 0.04em;
            width: 100%;
            padding: 13px;
            border-radius: 14px;
            border: none;
            cursor: pointer;
            background: linear-gradient(135deg, var(--admin-coral, #e65453) 0%, var(--admin-coral-deep, #d33d3c) 100%);
            color: var(--console-ink, #0f172a);
            position: relative;
            overflow: hidden;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            box-shadow: 0 4px 18px rgba(var(--admin-coral-rgb, 230, 84, 83), 0.35);
        }

        .xiro-login-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 55%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
            pointer-events: none;
        }

        .xiro-login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(var(--admin-coral-rgb, 230, 84, 83), 0.5);
        }

        .xiro-login-btn:hover::after {
            animation: btnShimmer 0.55s ease forwards;
        }

        .xiro-login-btn:active {
            transform: translateY(0);
            box-shadow: 0 3px 10px rgba(var(--admin-coral-rgb, 230, 84, 83), 0.3);
        }

        .xiro-login-btn-secondary {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 0.02em;
            width: 100%;
            padding: 11px;
            border-radius: 12px;
            border: 1px solid rgba(var(--admin-coral-rgb, 230, 84, 83), 0.35);
            background: rgba(255, 255, 255, 0.03);
            color: var(--admin-coral-tint, #ffd8d8);
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s;
        }

        .xiro-login-btn-secondary:hover {
            background: rgba(var(--admin-coral-rgb, 230, 84, 83), 0.10);
            border-color: rgba(var(--admin-coral-rgb, 230, 84, 83), 0.55);
        }

        .xiro-login-divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0.1rem 0;
        }

        .xiro-login-divider span {
            flex: 1;
            height: 1px;
            background: rgba(255, 255, 255, 0.07);
        }

        /* Mascot */
        .xiro-detective {
            position: fixed;
            bottom: -18px;
            right: -12px;
            width: clamp(110px, 11vw, 165px);
            opacity: 0.30;
            pointer-events: none;
            filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45));
            transform: scaleX(-1);
            animation: mascoFloat 7s ease-in-out infinite;
        }

/* ===== Sidebar nav — Preguntas / User / Config ===== */
/* Interacción reforzada sobre la base Tailwind ya existente en admin.html:
   ligero desplazamiento + sombra al hover, y el icon-wrapper gana el mismo
   "tilt" sutil que las role cards del resto del producto (DESIGN.md), pero
   atenuado para un panel de operación (Modo Operate: discreto, no vistoso). */
#sidebar-nav-section .nav-button,
#user-sidebar-section button,
#config-sidebar-section button,
#config-sidebar-section a {
    transition: background-color 0.2s ease, transform 0.2s ease,
        box-shadow 0.2s ease, border-color 0.2s ease;
}

#sidebar-nav-section .nav-button:hover,
#user-sidebar-section button:hover,
#config-sidebar-section button:hover,
#config-sidebar-section a:hover {
    transform: translateX(3px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
}

#sidebar-nav-section .nav-button:active,
#user-sidebar-section button:active,
#config-sidebar-section button:active,
#config-sidebar-section a:active {
    transform: translateX(1px) scale(0.99);
}

#btn-panic:active {
    transform: none;
}

#sidebar-nav-section .nav-button>div:first-child,
#user-sidebar-section button>div:first-child,
#config-sidebar-section button>div:first-child,
#config-sidebar-section a>div:first-child {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 0.25s ease;
}

#sidebar-nav-section .nav-button:hover>div:first-child,
#user-sidebar-section button:hover>div:first-child,
#config-sidebar-section button:hover>div:first-child,
#config-sidebar-section a:hover>div:first-child {
    transform: scale(1.08) rotate(-3deg);
}

#sidebar-nav-section .nav-button:focus-visible,
#user-sidebar-section button:focus-visible,
#config-sidebar-section button:focus-visible,
#config-sidebar-section a:focus-visible {
    outline: 2px solid var(--admin-coral, #e65453);
    outline-offset: 2px;
}