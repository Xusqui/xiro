{
  "scripts": {
    "build:css": "npm run build:css:common && npm run build:css:admin && npm run build:css:player && npm run build:css:presenter && npm run build:css:index",
    "watch:css": "npm run watch:css:common & npm run watch:css:admin & npm run watch:css:player & npm run watch:css:presenter & npm run watch:css:index",
    "build:css:common": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-common.css -o ./app/public/css/common.css --minify",
    "build:css:admin": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-admin.css -o ./app/public/css/output-admin.css --minify",
    "build:css:player": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-player.css -o ./app/public/css/output-player.css --minify",
    "build:css:presenter": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-presenter.css -o ./app/public/css/output-presenter.css --minify",
    "build:css:index": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-index.css -o ./app/public/css/output-index.css --minify",
    "watch:css:common": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-common.css -o ./app/public/css/common.css --watch",
    "watch:css:admin": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-admin.css -o ./app/public/css/output-admin.css --watch",
    "watch:css:player": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-player.css -o ./app/public/css/output-player.css --watch",
    "watch:css:presenter": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-presenter.css -o ./app/public/css/output-presenter.css --watch",
    "watch:css:index": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -i ./app/public/css/input-index.css -o ./app/public/css/output-index.css --watch"
  },
  "devDependencies": {
    "browserslist": "^4.28.1",
    "tailwindcss": "^3.4.19"
  }
}